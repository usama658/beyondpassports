APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Beyond Passports feature flags ─────────────────────────────────────────────
# Appointment display mode on the public board + slot-picker popup.
#   true  -> week labels ("Next Week Aug 2026", "3rd Week Aug 2026"); popup shows
#            one chip per week holding the soonest slot.
#   false -> exact dates ("17 Aug 2026") with a per-day/time picker (original).
# Fully reversible either way. After changing, run on the host:
#   php artisan config:clear && php artisan view:clear && php artisan cache:clear
UKV_SLOT_WEEK_LABELS=true

# Count/centre mode. Board cards feature only the SLOT COUNT ("Slots open / N / in next 90 days"),
# centred, instead of the date/week; AND the slot popup becomes a CENTRE picker (pick a centre, we
# book its soonest slot — no date/week chips). Overrides UKV_SLOT_WEEK_LABELS. Same clear commands.
UKV_SLOT_COUNT_FOCUS=false

# Board renders as NEON-GLASS cards (frosted 2-up cards, band glow edge, big slot count, WhatsApp
# "Secure") — "Light Mist" palette. Mode 4. Run only ONE of week_labels / count_focus / rows true.
UKV_SLOT_ROWS=false

# UK timezone so Carbon::today() (and the week-label math) match the UK date, not
# UTC. Leave as Europe/London for a UK-only business.
APP_TIMEZONE=Europe/London
